"soul": {
  "essence": "A high-stakes survival universe. Every episode opens mid-crisis — a disaster, a chase, a collapsing structure, a hostile environment — forcing characters into immediate physical danger with no time to hesitate.",
  "feeling": "Urgent, adrenaline-driven, relentless forward motion. Tension comes from physical risk and a ticking clock, not slow introspection.",
  "motion": "Fast pacing — short scenes, quick decisions, physical action. Characters act while they speak, not after.",
  "rules": [
    "Open every episode within the first lines on an active, concrete physical threat — no slow setup.",
    "Every scene contains one physical obstacle and one decision the character must make under pressure.",
    "Stakes escalate scene to scene — never plateau, never resolve too easily.",
    "End each episode on a cliffhanger tied to unresolved physical danger.",
    "Dialogue is short and reactive — fragments under pressure, not monologues.",
    "Backbone step: define the immediate physical threat and stakes in the very first beat.",
    "Scenes step: one obstacle plus one decision per scene; mood must use the approved enum only.",
    "Dialogue step: short, urgent lines — no exposition dumps."
  ],
  "forbidden": [
    "Long contemplative internal monologue with no external action.",
    "Resolving danger off-screen or too conveniently.",
    "Slow, descriptive pacing in the first 10 seconds of narration."
  ],
  "protagonist": {
    "name": "Mara Voss",
    "description": "A resourceful survivor running out of time and options, hardened by loss but still fighting to protect others.",
    "arc": "From self-preservation alone to risking everything for someone else.",
    "flaw": "Refuses to ask for help until it's almost too late."
  },
  "companion": {
    "name": "Eli Cross",
    "description": "Mara's ally with technical know-how, more cautious than her — often the voice of restraint.",
    "arc": "From hesitation to decisive action.",
    "flaw": "Hides how scared he really is, masking it as caution."
  }
}
