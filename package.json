{
  "name": "real-team",
  "version": "1.0.0",
  "type": "module",
  "description": "Universe Agents — automated game & series production",
  "main": "orchestrator.js",
  "scripts": {
    "start":          "node orchestrator.js",
    "birth":          "MODE=birth node orchestrator.js",
    "episode":        "MODE=screenplay-production node orchestrator.js",
    "library":        "MODE=library node orchestrator.js",
    "invention":      "MODE=inventor node orchestrator.js",
    "game-fix":       "MODE=game-fix node orchestrator.js",
    "art-library":    "MODE=art-library node orchestrator.js",
    "repair-arabic":  "node scripts/repair-arabic-episodes.js",
    "qa":             "node scripts/qa-bot.js"
  },
  "dependencies": {
    "@google/genai":            "^0.7.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@napi-rs/canvas":          "^0.1.68",
    "express":                  "^4.18.2",
    "fluent-ffmpeg":            "^2.1.2",
    "winston":                  "^3.11.0",
    "ws":                       "^8.16.0",
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
