{
  "buildCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/ep.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/ep", "destination": "/api/ep" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
