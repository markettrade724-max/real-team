  "rules": [
    { "id":"rule-055", "scope":["all"],                  "description":"askGemini تقبل دائماً معاملات إضافية (options) كـ topP, topK, maxOutputTokens." },
    { "id":"rule-056", "scope":["all"],                  "description":"كل وكيل يقرأ وثيقة الروح عبر soulContext('agentName')." },
    { "id":"rule-058", "scope":["godot","code-agent"],   "description":"اسم preset = 'Web' دائماً. لا 'HTML5' في Godot 4.x." },
    { "id":"rule-061", "scope":["all"],                  "description":"الإيموجي محظور في commit messages وفي agent logs." },
    { "id":"rule-063", "scope":["orchestrator"],         "description":"orchestrator v8.0 أوضاع: BIRTH/EVOLUTION/INVENTION/REVIVAL/SYNC/CODE/EPISODE/LIBRARY." },
    { "id":"rule-064", "scope":["orchestrator"],         "description":"العوالم أولوية مطلقة. إذا عددها أقل من اليوم من السنة، يُولد عالم جديد أولاً." },
    { "id":"rule-070", "scope":["godot"],                "description":"في Godot 4.x، اسم منصة الويب هو 'Web' دائماً." },
    { "id":"rule-077", "scope":["workflow"],             "description":"shell: bash في godot-export.yml فقط. shell: pwsh في جميع الـ workflows الأخرى." },
    { "id":"rule-087", "scope":["all"],                  "description":"askGemini(prompt, temperature, options, caller). لا تدمج temperature في الكائن." },
    { "id":"rule-089", "scope":["all"],                  "description":"جميع الوكلاء يطلبون JSON — _gemini.js يستخدم responseMimeType: 'application/json'." },
    { "id":"rule-097", "scope":["all"],                  "description":"لا تغير نموذج Gemini (gemini-2.5-flash) إلا بطلب صريح. قاعدة ذهبية." },
    { "id":"rule-098", "scope":["all"],                  "description":"جميع استدعاءات Gemini تمر عبر askGemini في _gemini.js. لا fetch مباشر." },
    { "id":"rule-099", "scope":["all"],                  "description":"استخدم [ERROR]/[INFO]/[OK]/[WARN] في console.log." },
    { "id":"rule-100", "scope":["_soul.js"],             "description":"soulContext يُرجع string دائماً: روح الكون + قواعد الوكيل." },
    { "id":"rule-101", "scope":["all"],                  "description":"استخدم maxOutputTokens وليس maxTokens." },
    { "id":"rule-102", "scope":["all"],                  "description":"لا JSON.parse مع نتيجة askGemini. _gemini.js يعيد الكائن مباشرة." },
    { "id":"rule-103", "scope":["code-agent"],           "description":"كل ملف .gd في استدعاء منفصل بـ 4096 token." },
    { "id":"rule-104", "scope":["_soul.js"],             "description":"soulContext يُرجع string فقط. لا كائن أبداً." },
    { "id":"rule-106", "scope":["workflow"],             "description":"GEMINI_API_KEY في كل مكان — كود، workflow، Secrets." },
    { "id":"rule-107", "scope":["supabase"],             "description":"Node.js 20: createClient(url, key, { realtime: { transport: ws } })." },
    { "id":"rule-108", "scope":["supabase"],             "description":"تجنب desc في PostgreSQL. استخدم description." },
    { "id":"rule-109", "scope":["vercel"],               "description":"انسخ products.json إلى public/ في كل تشغيل." },
    { "id":"rule-110", "scope":["godot"],                "description":"لا تطلب project.godot من Gemini. ابنه محلياً." },
    { "id":"rule-111", "scope":["orchestrator"],         "description":"جدول الأسبوع: أحد=inventor / اثنين+أربعاء+جمعة=revival / خميس=roadmap / سبت=sync+analytics." },
    { "id":"rule-112", "scope":["orchestrator"],         "description":"getDayOfYear() يبدأ من 1: Math.floor((now-start)/86400000)+1." },
    { "id":"rule-115", "scope":["inventor-agent"],       "description":"inventor-agent كل أحد. العبقرية أو لا شيء. ينشر للبيع على itch.io وKo-fi." },
    { "id":"rule-117", "scope":["world-birth-agent"],    "description":"world-birth-agent: 3 استدعاءات: core → elements → senses." },
    { "id":"rule-118", "scope":["world-birth-agent"],    "description":"كل عالم: قانون فيزيائي + عدوان + سلاح + حواس. مستوحى من Dark Souls وHollow Knight." },
    { "id":"rule-119", "scope":["godot-export"],         "description":"استخدم مسار نسبي للـ OUTPUT_DIR بدون $(pwd)." },
    { "id":"rule-120", "scope":["godot-export"],         "description":"git stash قبل git pull --rebase." },
    { "id":"rule-121", "scope":["workflow"],             "description":"لا cache: npm إلا إذا كان package-lock.json موجوداً." },
    { "id":"rule-122", "scope":["_gemini.js"],           "description":"retry مرة واحدة فقط. JSON مقطوع يضاعف tokens بدون retry شبكي." },
    { "id":"rule-123", "scope":["inventor-agent"],       "description":"كل اختراع = منتج للبيع على itch.io وKo-fi وGumroad." },
    { "id":"rule-124", "scope":["content-agent"],        "description":"content-agent: سكريبت 60 ثانية كل 8 ساعات. مزيج: حياة + تقنية + دراما + فكاهة." },
    { "id":"rule-125", "scope":["content-agent"],        "description":"content-agent يحفظ المواضيع المستخدمة في content-topics.json." },
    { "id":"rule-126", "scope":["all"],                  "description":"لا bash scripts في أي وكيل. Node.js خالص: fluent-ffmpeg، fetch()، fs." },
    { "id":"rule-127", "scope":["workflow"],             "description":"جميع الـ workflows: windows-latest + pwsh. استثناء واحد: godot-export.yml يستخدم bash." },
    { "id":"rule-128", "scope":["_gemini.js"],           "description":"budget.json موحد: 14 للمكتبة + 6 للوكلاء = 20/يوم. كل caller مُسجَّل." },
    { "id":"rule-129", "scope":["library-builder-agent"],"description":"كل مرجع يُبنى بـ byAgent. readForAgent() تقرأ byAgent[agentName] تحديداً." },
    { "id":"rule-130", "scope":["series-agent"],         "description":"خط الإنتاج إلزامي: screenplay → dialogue → scene → voice → subtitle → visual → edit → trailer → upload." },
    { "id":"rule-131", "scope":["screenplay-agent"],     "description":"screenplay-agent يقرأ audience-insights.json قبل الكتابة." },
    { "id":"rule-132", "scope":["music-agent"],          "description":"أولوية: Suno API → CC0 → ffmpeg local. تُخزَّن في assets/music/." },
    { "id":"rule-133", "scope":["trailer-agent"],        "description":"التريلر 60s: hook(5s)+peak(40s)+cliffhanger(15s). 9:16 عمودي." },
    { "id":"rule-134", "scope":["upload-agent"],         "description":"يوتيوب: الحلقة الكاملة + شورتس. تيك توك: التريلر 60s فقط." },
    { "id":"rule-135", "scope":["analytics-agent"],      "description":"analytics-agent كل سبت. يحفظ audience-insights.json. لا Gemini — منطق محلي." },
    { "id":"rule-136", "scope":["dialogue-agent"],       "description":"dialogue-agent لا يستهلك Gemini. يعمل من DIALOGUE_PATTERNS + مكتبة." },
    { "id":"rule-137", "scope":["subtitle-agent"],       "description":"subtitle-agent لا يستهلك Gemini. يولد SRT + WebVTT من audioManifest." },
    { "id":"rule-138", "scope":["all"],                  "description":"npm إلزامي: fluent-ffmpeg + @ffmpeg-installer/ffmpeg + edge-tts-node. لا pip." },
    { "id":"rule-139", "scope":["all"],                  "description":"Zero Cost Policy: لا إنفاق حتى يبدأ الدخل. Imagen مؤجل → Lexica/Unsplash. Suno مؤجل → CC0." }
  ],

