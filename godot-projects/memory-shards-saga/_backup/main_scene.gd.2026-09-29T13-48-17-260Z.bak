extends Node3D

# IMPORTANT: Ensure the following input actions are defined in Project Settings -> Input Map:
# - "ui_cancel": Used for pausing/unpausing.
# - "ui_accept": Used for restarting the game from Game Over/Victory screens.

@export var pause_menu_layer: CanvasLayer
@export var hud_layer: CanvasLayer # New: For displaying player health, score, etc.
@export var game_over_layer: CanvasLayer # New: For displaying game over screen
@export var victory_layer: CanvasLayer # New: For displaying victory screen
@export var player_scene: PackedScene # New: To instantiate the player
@export var player_spawn_point_path: NodePath # New: Path to a Marker3D for player spawn
@export var next_level_scene_path: String # New: Path to the next level scene for progression

# Exported NodePaths for UI Labels for better flexibility and editor integration
@export var hud_score_label_path: NodePath
@export var hud_health_label_path: NodePath
@export var game_over_label_path: NodePath
@export var victory_label_path: NodePath

enum GameState {
	GAMEPLAY,
	PAUSED,
	GAME_OVER, # New: Added Game Over state
	VICTORY # New: Added Victory state
}

var current_state: GameState = GameState.GAMEPLAY # Changed: Start directly in gameplay
var _player_instance: CharacterBody3D # To hold the spawned player
var score: int = 0 # New: Score variable

# References to UI Labels
var _score_label: Label
var _health_label: Label
var _game_over_label: Label
var _victory_label: Label

func _ready():
	process_mode = Node.PROCESS_MODE_ALWAYS
	
	# Get references to labels using exported NodePaths
	_score_label = get_node_or_null(hud_score_label_path)
	if not _score_label: push_warning("HUD ScoreLabel not found at path: %s. Score display will not work." % hud_score_label_path)
	
	_health_label = get_node_or_null(hud_health_label_path)
	if not _health_label: push_warning("HUD HealthLabel not found at path: %s. Health display will not work." % hud_health_label_path)
	
	_game_over_label = get_node_or_null(game_over_label_path)
	if not _game_over_label: push_warning("Game Over Label not found at path: %s. Game Over text will not display." % game_over_label_path)
	
	_victory_label = get_node_or_null(victory_label_path)
	if not _victory_label: push_warning("Victory Label not found at path: %s. Victory text will not display." % victory_label_path)
	
	# Connect to child_entered_tree once in _ready to catch all dynamically spawned nodes.
	# This ensures enemies spawned in any state (even paused) have their signals connected.
	if not get_tree().child_entered_tree.is_connected(_on_child_entered_tree):
		get_tree().child_entered_tree.connect(_on_child_entered_tree)

	# Start directly in gameplay as per SOUL document, removing the MAIN_MENU state.
	_set_game_state(GameState.GAMEPLAY)

func _input(event: InputEvent):
	match current_state:
	    # GameState.MAIN_MENU removed as per SOUL document requirements
	    GameState.GAMEPLAY:
	        if event.is_action_pressed("ui_cancel"):
	            _set_game_state(GameState.PAUSED)
	            get_viewport().set_input_as_handled()
	    GameState.PAUSED:
	        if event.is_action_pressed("ui_cancel"):
	            _set_game_state(GameState.GAMEPLAY)
	            get_viewport().set_input_as_handled()
	    GameState.GAME_OVER, GameState.VICTORY: # Allow restarting from game over or victory screen
	        if (event is InputEventMouseButton and event.is_pressed()) or \
	           (event is InputEventScreenTouch and event.is_pressed()) or \
	           event.is_action_pressed("ui_accept"): # Assuming 'ui_accept' for restart
	            if current_state == GameState.VICTORY and next_level_scene_path:
	                get_tree().change_scene_to_file(next_level_scene_path) # Progress to next level
	            else:
	                get_tree().reload_current_scene() # Restart current level or if no next level
	            get_viewport().set_input_as_handled()

func _connect_enemy_signals(enemy_node: Node):
	# Assumes enemy nodes are in the "enemy" group and emit a 'died' signal with an optional 'points' argument.
	if enemy_node.is_in_group("enemy"):
	    if enemy_node.has_signal("died"):
	        if not enemy_node.died.is_connected(_on_enemy_died):
	            enemy_node.died.connect(_on_enemy_died)
	    else:
	        push_warning("Enemy '%s' does not emit 'died' signal. Score/win condition will not work for it." % enemy_node.name)

func _on_child_entered_tree(node: Node):
	_connect_enemy_signals(node)

func _set_game_state(new_state: GameState):
	current_state = new_state
	
	# Hide all layers initially
	# main_menu_layer export and related code removed
	if pause_menu_layer: pause_menu_layer.hide()
	if hud_layer: hud_layer.hide()
	if game_over_layer: game_over_layer.hide()
	if victory_layer: victory_layer.hide() # New: Hide victory layer
	
	get_tree().paused = false # Default to not paused, states will override if needed
	
	# Removed the disconnect/reconnect logic for child_entered_tree from here.
	# It is now connected once in _ready() and remains connected.

	match current_state:
	    # GameState.MAIN_MENU removed
	    GameState.GAMEPLAY:
	        if hud_layer: hud_layer.show() # Show HUD
	        _spawn_player_if_needed()
	        _update_score_display() # Initial score display
	        
	        # Connect signals for all existing enemies in the scene that are in the "enemy" group.
	        # This is still needed for enemies that exist at scene load, before _ready() finishes.
	        for enemy in get_tree().get_nodes_in_group("enemy"):
	            _connect_enemy_signals(enemy)
	        
	    GameState.PAUSED:
	        get_tree().paused = true
	        if pause_menu_layer: pause_menu_layer.show()
	        
	    GameState.GAME_OVER:
	        get_tree().paused = true # Pause the game on Game Over
	        if game_over_layer: game_over_layer.show() # Show Game Over screen
	        _update_game_over_display()
	        
	    GameState.VICTORY: # New: Victory state handling
	        get_tree().paused = true # Pause the game on Victory
	        if victory_layer: victory_layer.show() # Show Victory screen
	        _update_victory_display()

func _spawn_player_if_needed():
	# Spawn player if not already present or if returning from main menu
	# Assumes the player scene emits 'player_died' and 'player_health_changed(new_health: int, max_health: int)' signals.
	if not is_instance_valid(_player_instance) and player_scene:
	    _player_instance = player_scene.instantiate()
	    
	    # Connect player signals for game over and HUD updates BEFORE adding to tree
	    # This ensures signals emitted in player's _ready() are caught.
	    if _player_instance.has_signal("player_died"):
	        _player_instance.player_died.connect(_on_player_died)
	    else:
	        push_warning("Player scene does not emit 'player_died' signal. Game over condition will not trigger.")
	    if _player_instance.has_signal("player_health_changed"):
	        _player_instance.player_health_changed.connect(_on_player_health_changed)
	    else:
	        push_warning("Player scene does not emit 'player_health_changed' signal. Health display will not update.")
	    
	    add_child(_player_instance) # Add player to the scene
	    
	    if player_spawn_point_path:
	        var spawn_point = get_node_or_null(player_spawn_point_path)
	        if spawn_point and spawn_point is Marker3D:
	            _player_instance.global_position = spawn_point.global_position
	        else:
	            push_warning("Player spawn point not found or not a Marker3D at path: %s. Spawning at default (0,1,0)." % player_spawn_point_path)
	            _player_instance.global_position = Vector3(0, 1, 0) # Fallback
	    else:
	        push_warning("Player spawn point path not set in main_scene.gd. Spawning at default (0,1,0).")
	        _player_instance.global_position = Vector3(0, 1, 0) # Default spawn position
	    
	    # Initial HUD update is now handled by the player's _ready() signal emission
	    # and the connected _on_player_health_changed function.
	    # The manual call below is no longer needed.
	elif not player_scene:
	    push_error("Player scene not assigned in main_scene.gd! Cannot start gameplay.")

func _on_player_died():
	print("Game Over! Player died.")
	_set_game_state(GameState.GAME_OVER)

func _on_player_health_changed(new_health: int, max_health: int):
	# Update a UI element on the hud_layer with player health
	print("HUD: Player Health: %d/%d" % [new_health, max_health])
	if _health_label:
	    _health_label.text = "HP: %d/%d" % [new_health, max_health]

# New: Score related functions
func _update_score_display():
	if _score_label:
		_score_label.text = "Score: %d" % score

# This function should be connected to an enemy's 'died' signal.
# Example: enemy_instance.died.connect(_on_enemy_died)
func _on_enemy_died(points: int = 10):
	score += points
	_update_score_display()
	# The enemy should remove itself from the "enemy" group or queue_free() itself
	# so that get_tree().get_nodes_in_group("enemy").size() updates correctly for the win condition.
	_check_win_condition()
	print("Enemy died! Score: %d" % score)

func _check_win_condition():
	# Checks if all enemies (nodes in the "enemy" group) have been defeated.
	var remaining_enemies = get_tree().get_nodes_in_group("enemy").size()
	print("Remaining enemies: %d" % remaining_enemies)
	if remaining_enemies == 0:
		_set_game_state(GameState.VICTORY)

# New: Game Over and Victory display functions
func _update_game_over_display():
	if _game_over_label:
		_game_over_label.text = "GAME OVER\nFinal Score: %d" % score

func _update_victory_display():
	if _victory_label:
		_victory_label.text = "VICTORY!\nFinal Score: %d" % score
