extends CharacterBody3D

# IMPORTANT: Ensure the following input actions are defined in Project Settings -> Input Map:
# - "fire": For shooting the weapon.
# - "jump": For player jumping.
# - "move_left", "move_right", "move_forward", "move_backward": For player movement.

@export var speed: float = 5.0
@export var jump_velocity: float = 4.5
@export var mouse_sensitivity: float = 0.002

@export var max_health: int = 100
var current_health: int

# Get the gravity from the project settings to be synced with RigidBody nodes.
var gravity: float = ProjectSettings.get_setting("physics/3d/default_gravity")

# Changed @onready vars to @export var NodePaths for flexibility
@export var camera_pivot_path: NodePath
@export var camera_path: NodePath
@export var weapon_path: NodePath

var camera_pivot: Node3D
var camera: Camera3D
var weapon: Node3D

signal player_died
signal player_health_changed(new_health: int, max_health: int) # New signal for HUD updates

func _ready() -> void:
	add_to_group("player")
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	current_health = max_health
	emit_signal("player_health_changed", current_health, max_health) # Initial health update for HUD

	# Get nodes using exported paths with robust checks
	if camera_pivot_path:
		camera_pivot = get_node_or_null(camera_pivot_path)
		if not camera_pivot: push_error("CameraPivot not found at path: %s" % camera_pivot_path)
	else:
		push_warning("CameraPivot path not set in Player scene.")

	if camera_path:
		camera = get_node_or_null(camera_path)
		if not camera: push_error("Camera3D not found at path: %s" % camera_path)
	else:
		push_warning("Camera3D path not set in Player scene.")

	if weapon_path:
		weapon = get_node_or_null(weapon_path)
		if not weapon: push_error("Weapon node not found at path: %s" % weapon_path)
	else:
		push_warning("Weapon path not set in Player scene.")

func _input(event: InputEvent) -> void:
	if event is InputEventMouseMotion and Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
	    # Rotate the player (yaw) for horizontal mouse movement
	    rotate_y(-event.relative.x * mouse_sensitivity)
	    # Rotate the camera pivot (pitch) for vertical mouse movement
	    if camera_pivot:
	        camera_pivot.rotate_x(-event.relative.y * mouse_sensitivity)
	        # Clamp the camera's vertical rotation to prevent flipping
	        camera_pivot.rotation.x = clamp(camera_pivot.rotation.x, deg_to_rad(-90), deg_to_rad(90))

	if event.is_action_just_pressed("fire"):
	    if weapon and weapon.has_method("shoot"):
	        weapon.shoot() # Calls the shoot method on the weapon node

func _physics_process(delta: float) -> void:
	# Apply gravity if not on the floor
	var velocity: Vector3 = linear_velocity
	if not is_on_floor():
	    velocity.y -= gravity * delta

	# Handle Jump input
	if Input.is_action_just_pressed("jump") and is_on_floor():
	    velocity.y = jump_velocity

	# Get the input direction for WASD movement
	var input_dir: Vector2 = Input.get_vector("move_left", "move_right", "move_forward", "move_backward")
	var direction: Vector3 = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()

	# Apply movement or decelerate if no input
	if direction:
	    velocity.x = direction.x * speed
	    velocity.z = direction.z * speed
	else:
	    velocity.x = move_toward(velocity.x, 0, speed)
	    velocity.z = move_toward(velocity.z, 0, speed)

	linear_velocity = velocity
	move_and_slide()

func take_damage(amount: int) -> void:
	if current_health <= 0:
	    return # Already dead, prevent further damage processing

	current_health -= amount
	print("Player took %d damage. Current health: %d" % [amount, current_health])
	emit_signal("player_health_changed", current_health, max_health) # Update health UI

	if current_health <= 0:
	    current_health = 0
	    die()

func die() -> void:
	print("Player died!")
	emit_signal("player_died")

	await get_tree().create_timer(0.5).timeout # Wait for 0.5 seconds
	if is_inside_tree():
	    queue_free()

# New methods to allow other scripts to query player health
func get_current_health() -> int:
	return current_health

func get_max_health() -> int:
	return max_health
